[Unit]
Description=GMVN Real-Time Inventory & Tariff Matrix Portal
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/var/www/gmvn-matrix
Environment="PATH=/var/www/gmvn-matrix/venv/bin"
ExecStart=/var/www/gmvn-matrix/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 4
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
